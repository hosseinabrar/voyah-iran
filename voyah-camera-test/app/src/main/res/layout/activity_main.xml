<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="@dimen/pad" android:layoutDirection="rtl" android:background="#1D2139">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="تست دوربین‌های خودرو" android:textSize="24sp" android:textColor="#FFFFFF"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="دوربین‌های اندروید" android:textColor="#FFFFFF"/>
<Spinner android:id="@+id/cameras" android:layout_width="match_parent" android:layout_height="48dp"/>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="مسیرهای فیزیکی — انتساب به آپولو مشخص نیست" android:textColor="#FFFFFF"/>
<Spinner android:id="@+id/physical" android:layout_width="match_parent" android:layout_height="48dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<Button android:id="@+id/open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="نمایش تصویر"/>
<Button android:id="@+id/stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="توقف"/>
<Button android:id="@+id/refresh" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="بازخوانی"/>
<Button android:id="@+id/share" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="ارسال گزارش"/>
</LinearLayout>
<TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="@dimen/body" android:textColor="#FFFFFF"/>
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:background="#000000"><TextureView android:id="@+id/preview" android:layout_width="match_parent" android:layout_height="match_parent"/></FrameLayout>
</LinearLayout>