<Window x:Class="VoyahIran.Installer.MainWindow" Style="{StaticResource DarkWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d" Title="نصاب وویا ایران" Icon="Assets/voyah-iran.ico" Width="1120" Height="760" MinWidth="900" MinHeight="640" WindowStartupLocation="CenterScreen" FlowDirection="RightToLeft" Loaded="WindowLoaded" Closing="WindowClosing">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="58"/></Grid.RowDefinitions>
    <Border Background="#1A212B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="32,18">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel><TextBlock Text="وویا ایران" FontSize="25" FontWeight="Bold"/><TextBlock Text="نصب و راه‌اندازی روی خودرو" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
        <Border Grid.Column="1" Background="#242E3A" CornerRadius="20" Padding="16,10" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><Ellipse Width="9" Height="9" Fill="{Binding ConnectionBrush}" Margin="0,0,9,0"/><TextBlock Text="{Binding ConnectionText}" d:Text="خودرو شناسایی نشده" VerticalAlignment="Center"/></StackPanel></Border>
      </Grid>
    </Border>
    <Grid Grid.Row="1" Margin="32,28">
      <Grid Visibility="{Binding HomeVisibility}" d:Visibility="Visible">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        
        <Border Grid.Row="1" Style="{StaticResource Card}">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="وویا ایران" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding VersionText}" d:Text="نسخهٔ 0.1.0" Foreground="{StaticResource AccentBrush}" Margin="0,8,0,0"/></StackPanel>
            <Button Grid.Column="1" Content="نصب" Style="{StaticResource PrimaryButton}" Command="{Binding InstallCommand}" VerticalAlignment="Center" Margin="24,0,0,0" AutomationProperties.Name="نصب"/>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="0,24,0,0"><TextBlock Text="خودرو متوقف باشد. پایان نصب، نمایشگر به‌صورت خودکار راه‌اندازی مجدد می‌شود." Foreground="{StaticResource MutedBrush}"/><StackPanel Orientation="Horizontal" Margin="0,24,0,0"><Button Content="نصب APK" Command="{Binding ApkCommand}" Margin="0,0,12,0"/><Button Content="راهنمای اتصال" Command="{Binding HelpCommand}"/><Button Content="پوشهٔ گزارش‌ها" Command="{Binding OpenLogsCommand}" Margin="12,0,0,0"/><Button Content="راه‌اندازی مجدد نمایشگر" Command="{Binding RebootCommand}" Margin="12,0,0,0"/></StackPanel></StackPanel>
      </Grid>
      <Grid Visibility="{Binding ProgressVisibility}" d:Visibility="Collapsed">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20"><TextBlock Text="{Binding ProgressTitle}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding ProgressSubtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Border Style="{StaticResource Card}" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel><TextBlock Text="مراحل نصب" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/><ItemsControl x:Name="StepsList" ItemsSource="{Binding Steps}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Symbol}" Foreground="{Binding Color}" FontFamily="Segoe UI Symbol" FontSize="18"/><TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding Color}" VerticalAlignment="Center"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></ScrollViewer></Border>
          <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16" Background="#0D1219"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="گزارش کامل نصب" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/><TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" FlowDirection="LeftToRight" TextAlignment="Left" FontFamily="Consolas" FontSize="12" Background="Transparent" Foreground="#C5D5E4" BorderThickness="0" TextWrapping="NoWrap" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="گزارش کامل نصب"/></Grid></Border>
        </Grid>
        <DockPanel Grid.Row="2" Margin="0,18,0,0"><StackPanel Orientation="Horizontal"><Button Content="کپی گزارش" Command="{Binding CopyCommand}"/><Button Content="پوشهٔ گزارش‌ها" Command="{Binding OpenLogsCommand}" Margin="12,0,0,0"/><Button Content="بازگشت" Command="{Binding HomeCommand}" IsEnabled="{Binding CanLeave}" Margin="12,0,0,0"/></StackPanel></DockPanel>
      </Grid>
    </Grid>
    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="32,16"><TextBlock Text="ابتدا USB debugging را روی ماشین فعال کنید و ماشین را با کابل USB به لپ‌تاپ متصل کنید." Foreground="{StaticResource MutedBrush}" FontSize="12"/></Border>
  </Grid>
</Window>



