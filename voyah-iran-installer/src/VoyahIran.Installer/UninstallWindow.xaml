<Window x:Class="VoyahIran.Installer.UninstallWindow" Style="{StaticResource DarkWindow}" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="حذف APK" Width="720" Height="330" FlowDirection="RightToLeft" WindowStartupLocation="CenterOwner" Loaded="OnLoaded" Closing="OnClosing">
<Grid Margin="24">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<TextBlock Text="انتخاب برنامه برای حذف" FontSize="24" Margin="0,0,0,20"/>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
<ComboBox x:Name="Apps" MinHeight="56" Foreground="{DynamicResource TextBrush}" Background="{DynamicResource PanelBrush}">
<ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Image Source="{Binding Image}" Width="40" Height="40" Margin="8"/><TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
</ComboBox>
<Button x:Name="RemoveButton" Grid.Column="1" Content="حذف برنامه" Click="Remove" Foreground="{DynamicResource ErrorBrush}" Margin="12,0,0,0" IsEnabled="False"/>
</Grid>
<TextBlock x:Name="Status" Grid.Row="2" TextWrapping="Wrap" Margin="0,20,0,0"/>
<StackPanel Grid.Row="3" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="RefreshButton" Content="تازه‌سازی" Click="Refresh"/><Button Content="کپی گزارش" Click="Copy" Margin="12,0,0,0"/></StackPanel>
</Grid>
</Window>
