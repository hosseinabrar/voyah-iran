<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TargetPlatformMoniker>Windows,Version=7.0</TargetPlatformMoniker>
    <AssemblyName>VoyahIran.Installer</AssemblyName><Version>2.1.0</Version>
    <InformationalVersion>2.1.0</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\voyah-iran.ico</ApplicationIcon>
    <DebugType>embedded</DebugType>
    <!-- External Android inputs are invisible to Visual Studio's fast up-to-date check. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../VoyahIran.Installer.Core/VoyahIran.Installer.Core.csproj" />
    <Resource Include="Assets\voyah-iran.ico" />
    <EmbeddedResource Include="../../payload/bundle.zip" LogicalName="VoyahIran.Payload.zip" />
  </ItemGroup>
  <!-- Refresh before resource embedding, not BeforePublish (which is too late). -->
  <Target Name="PrepareVoyahPayload" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Condition="'$(Configuration)' == 'Release'" Command="powershell.exe -STA -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\Publish-Android.ps1&quot; -PreparePayload -ReuseUnchanged" />
    <Exec Condition="'$(Configuration)' != 'Release'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\build\Prepare-Payload.ps1&quot;" />
  </Target>
  <Target Name="RejectStalePayloadPublish" BeforeTargets="Publish" Condition="'$(NoBuild)' == 'true'">
    <Error Text="Publish with NoBuild is unsupported: publish with build enabled so the latest Android payload is embedded." />
  </Target>
  <Target Name="NameInstallerRelease" AfterTargets="Publish" Condition="'$(PublishSingleFile)' == 'true'">
    <PropertyGroup>
      <_InstallerOriginal>$([System.IO.Path]::Combine('$(PublishDir)', '$(AssemblyName).exe'))</_InstallerOriginal>
      <_InstallerVersioned>$([System.IO.Path]::Combine('$(PublishDir)', 'voyah-iran-installer_$(Version).exe'))</_InstallerVersioned>
    </PropertyGroup>
    <Move SourceFiles="$(_InstallerOriginal)" DestinationFiles="$(_InstallerVersioned)" />
    <Message Importance="high" Text="Installer: $(_InstallerVersioned)" />
  </Target>
</Project>
