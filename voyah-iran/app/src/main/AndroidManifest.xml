<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Loopback connection to the authenticated, installer-provisioned bridge. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <queries>
        <provider android:authorities="com.pateo.baiduStateProvider" />
        <intent><action android:name="android.view.InputMethod" /></intent>
        <package android:name="com.google.android.inputmethod.latin" />
        <package android:name="com.qinggan.keymanager.service" />
        <package android:name="com.qinggan.canbus.service" />
        <package android:name="com.qinggan.app.vehiclesetting" />
    </queries>
    <application
        android:name=".VoyahIranApplication"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@drawable/ic_app"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoyahIran">
        <receiver android:name=".core.bridge.BridgeProvisionReceiver" android:exported="true"
            android:permission="android.permission.INSTALL_PACKAGES" />
        <activity android:name=".feature.launcher.LauncherMapAnchorActivity" android:exported="true"
            android:taskAffinity="com.abrar.voyahiran.mapanchor" android:launchMode="singleTask"
            android:excludeFromRecents="true" android:resizeableActivity="true"
            android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name=".feature.launcher.LauncherAppsActivity" android:taskAffinity="com.abrar.voyahiran.apps" android:configChanges="uiMode" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape" android:excludeFromRecents="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name=".feature.launcher.PassengerAppsActivity" android:taskAffinity="com.abrar.voyahiran.passenger.apps" android:configChanges="uiMode" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape" android:excludeFromRecents="true" android:resizeableActivity="true" android:theme="@android:style/Theme.Material.NoActionBar" />
        <activity android:name=".feature.launcher.VoyahLauncherActivity" android:configChanges="uiMode" android:exported="true" android:launchMode="singleTask" android:screenOrientation="landscape" android:excludeFromRecents="true" android:theme="@style/Theme.VoyahLauncher" />
        <activity android:name=".feature.launcher.PassengerLauncherActivity" android:taskAffinity="com.abrar.voyahiran.passenger.home" android:configChanges="screenSize|smallestScreenSize|orientation|density|uiMode" android:exported="true" android:launchMode="singleTask" android:resizeableActivity="true" android:screenOrientation="landscape" android:excludeFromRecents="true" android:theme="@style/Theme.VoyahLauncher" />
                <activity android:name=".feature.launcher.LauncherDrawerActivity" android:taskAffinity="com.abrar.voyahiran.drawer" android:exported="false" android:screenOrientation="landscape" android:excludeFromRecents="true" />
        <service android:name=".feature.launcher.LauncherDrawerService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="فهرست برنامه‌ها">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/launcher_drawer_service" />
        </service>
        <service android:name="com.abrar.raha.feedback.RahaOverlayService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="رها">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/raha_overlay_service" />
        </service>
        <service android:name=".feature.navigation.NeshanDrivingService" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:label="@string/neshan_auto_driving">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/neshan_driving_service" />
        </service>
        <service android:name=".feature.media.SteeringMediaListener" android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE" android:label="@string/media_controls_label">
            <intent-filter><action android:name="android.service.notification.NotificationListenerService" /></intent-filter>
        </service>
        <service android:name=".feature.voice.RahaService" android:exported="false" android:foregroundServiceType="microphone" />
        <service android:name=".feature.steering.service.StarBackService" android:exported="false" />
        <service android:name=".feature.drivememory.service.DriveMemoryService" android:exported="false" />
        <receiver android:name=".core.startup.AppBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <service android:name=".feature.subscription.SubscriptionService" android:exported="false" />
        <activity android:name=".feature.subscription.SubscriptionActivity" android:exported="false" android:launchMode="singleTop" android:theme="@style/Theme.VoyahIran.Subscription" />
        <activity android:name=".feature.launcher.ClusterMapActivity" android:exported="true" android:resizeableActivity="true"
            android:theme="@style/Theme.VoyahIran.ClusterMap" android:excludeFromRecents="true"
            android:taskAffinity="com.abrar.voyahiran.cluster.map" android:configChanges="screenSize|smallestScreenSize|orientation|density|uiMode" />
        <activity android:name=".ui.MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>

