<?xml version="1.0" encoding="utf-8"?>
<!-- H97C launcher activity exit: centered scale and alpha, OEM timing/interpolator. -->
<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false" android:zAdjustment="top">
    <alpha android:duration="400" android:fromAlpha="1" android:toAlpha="0" android:interpolator="@android:interpolator/accelerate_decelerate" />
    <scale android:duration="400" android:fromXScale="1" android:toXScale="0.8" android:fromYScale="1" android:toYScale="0.8" android:pivotX="50%" android:pivotY="50%" android:fillAfter="false" android:interpolator="@android:interpolator/accelerate_decelerate" />
</set>
