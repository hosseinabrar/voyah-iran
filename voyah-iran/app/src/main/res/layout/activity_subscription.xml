<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:layoutDirection="rtl"
    android:gravity="center" android:padding="32dp" android:background="#202642">
    <ProgressBar android:id="@+id/progress" android:layout_width="72dp"
        android:layout_height="72dp" android:indeterminateTint="#AEBFFF" />
    <ImageView android:id="@+id/statusIcon" android:layout_width="88dp"
        android:layout_height="88dp" android:importantForAccessibility="no"
        android:visibility="gone" />
    <TextView android:id="@+id/message" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:gravity="center" android:textAlignment="center"
        android:text="@string/subscription_checking" android:textColor="#FFFFFF"
        android:textSize="22sp" />
    <TextView android:id="@+id/contact" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:layoutDirection="ltr" android:textDirection="ltr" android:gravity="center"
        android:text="@string/subscription_contact" android:textColor="#B9D5FF"
        android:textSize="24sp" android:textStyle="bold" android:visibility="gone" />
    <Button android:id="@+id/retry" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="@string/subscription_retry" android:textSize="20sp" android:visibility="gone" />
    <Button android:id="@+id/exit" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="24dp"
        android:text="@string/subscription_exit" android:textSize="20sp" android:visibility="gone" />
</LinearLayout>
