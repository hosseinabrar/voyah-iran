<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:fillViewport="true"
    android:visibility="gone"
    tools:visibility="visible"
    tools:background="@color/background"
    tools:context=".ui.MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="@dimen/page_padding">
        <TextView style="@style/Text.Heading" android:text="@string/comfort_tab" android:accessibilityHeading="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox
                android:id="@+id/driveMemory"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" android:textDirection="rtl"
                android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/drive_memory_label" tools:enabled="true" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/drive_memory_description" />
            <ProgressBar android:id="@+id/driveProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" android:indeterminate="true"
                android:indeterminateTint="@color/accent" android:visibility="gone" />
            <TextView android:id="@+id/driveStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_md" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/driveRetry" style="@style/Oem.Button"
                android:layout_width="wrap_content" android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_sm" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/recoveryMemory"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" android:textDirection="rtl"
                android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/recovery_memory_label" tools:enabled="true" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/recovery_memory_description" />
            <ProgressBar android:id="@+id/recoveryProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" android:indeterminate="true"
                android:indeterminateTint="@color/accent" android:visibility="gone" />
            <TextView android:id="@+id/recoveryStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_md" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/recoveryRetry" style="@style/Oem.Button"
                android:layout_width="wrap_content" android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_sm" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/energyModeMemory"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" android:textDirection="rtl"
                android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/energy_mode_memory_label" tools:enabled="true" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/energy_mode_memory_description" />
            <ProgressBar android:id="@+id/energyModeProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" android:indeterminate="true"
                android:indeterminateTint="@color/accent" android:visibility="gone" />
            <TextView android:id="@+id/energyModeStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_md" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/energyModeRetry" style="@style/Oem.Button"
                android:layout_width="wrap_content" android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_sm" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/aebMemory"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" android:textDirection="rtl"
                android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/aeb_memory_label" tools:enabled="true" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/aeb_memory_description" />
            <ProgressBar android:id="@+id/aebProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" android:indeterminate="true"
                android:indeterminateTint="@color/accent" android:visibility="gone" />
            <TextView android:id="@+id/aebStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_md" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/aebRetry" style="@style/Oem.Button"
                android:layout_width="wrap_content" android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_sm" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/pedestrianMemory"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target"
                android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body" android:textDirection="rtl"
                android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/pedestrian_memory_label" tools:enabled="true" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/pedestrian_memory_description" />
            <ProgressBar android:id="@+id/pedestrianProgress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_md" android:indeterminate="true"
                android:indeterminateTint="@color/accent" android:visibility="gone" />
            <TextView android:id="@+id/pedestrianStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_md" android:accessibilityLiveRegion="polite" android:visibility="gone" />
            <Button android:id="@+id/pedestrianRetry" style="@style/Oem.Button"
                android:layout_width="wrap_content" android:layout_gravity="start"
                android:layout_marginTop="@dimen/space_sm" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/avmTurnCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg" android:visibility="gone">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/avmTurn" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
                android:textDirection="rtl" android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/avm_turn_label" />
            <TextView style="@style/Text.Secondary" android:text="@string/avm_turn_description" android:layout_marginTop="@dimen/space_sm" />
            <TextView android:id="@+id/avmTurnStatus" style="@style/Text.Caption" android:accessibilityLiveRegion="polite" android:layout_marginTop="@dimen/space_sm" />
            <Button android:id="@+id/avmTurnRetry" style="@style/Oem.Button" android:layout_width="wrap_content" android:text="@string/retry" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shadeDepartureCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/shadeDeparture"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
                android:textDirection="rtl" android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/shade_departure_label" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/shade_departure_description" />
            <TextView android:id="@+id/shadeDepartureStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_sm" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/shadeReadyCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/shadeReady"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
                android:textDirection="rtl" android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/shade_ready_label" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/shade_ready_description" />
            <TextView android:id="@+id/shadeReadyStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_sm" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/dowAmbientCard" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_lg" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="@dimen/space_lg">
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/dowAmbient"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
                android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
                android:textDirection="rtl" android:gravity="center_vertical|start" android:enabled="false"
                android:text="@string/dow_ambient_label" />
            <TextView style="@style/Text.Secondary" android:layout_marginTop="@dimen/space_sm" android:text="@string/dow_ambient_description" />
            <LinearLayout android:id="@+id/dowMode" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="horizontal" android:layout_marginTop="@dimen/space_sm" android:visibility="gone">
                <ToggleButton android:id="@+id/dowAlways" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:textOn="همیشه" android:textOff="همیشه" />
                <ToggleButton android:id="@+id/dowDoorOnly" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:layout_marginStart="8dp" android:checked="true" android:textOn="با باز شدن درب" android:textOff="با باز شدن درب" />
            </LinearLayout>
            <TextView android:id="@+id/dowAmbientStatus" style="@style/Text.Caption"
                android:layout_marginTop="@dimen/space_sm" android:accessibilityLiveRegion="polite" android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
