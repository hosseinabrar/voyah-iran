<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl" android:visibility="gone">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding">
        <TextView style="@style/Text.Heading" android:text="@string/diagnostics_tab" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="@dimen/space_md">
            <Button android:id="@+id/readErrors" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/diagnostics_read" />
            <Button android:id="@+id/clearErrors" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="@dimen/space_md" android:text="@string/diagnostics_clear" />
        </LinearLayout>
        <Button android:id="@+id/readLocal" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/diagnostics_local" />
        <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:visibility="gone" />
        <TextView android:id="@+id/status" style="@style/Text.Body" android:layout_marginTop="@dimen/space_md" android:text="@string/diagnostics_hint" />
        <TextView android:id="@+id/results" style="@style/Text.Body" android:layout_marginTop="@dimen/space_md" android:textIsSelectable="true" />
        <TextView style="@style/Text.Caption" android:layout_marginTop="@dimen/space_md" android:text="@string/diagnostics_scope" />
    </LinearLayout>
</ScrollView>
