<CheckBox android:id="@+id/permissionMicrophone" style="@style/PermissionTile" android:text="@string/perm_microphone" tools:enabled="true"/>
<CheckBox android:id="@+id/permissionCamera" style="@style/PermissionTile" android:text="@string/perm_camera" tools:enabled="true"/>
<CheckBox android:id="@+id/permissionLocation" style="@style/PermissionTile" android:text="@string/perm_location" tools:enabled="true"/>
</LinearLayout>
