<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent" android:layoutDirection="rtl"
    android:fillViewport="true" android:visibility="gone" tools:visibility="visible" tools:background="@color/background">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="@dimen/page_padding">
        <TextView style="@style/Text.Heading" android:text="@string/raha_tab" android:accessibilityHeading="true" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:layout_marginTop="@dimen/space_lg" android:padding="@dimen/space_lg" android:background="@drawable/bg_card">
<com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/master" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
        android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
        android:textDirection="rtl" android:gravity="center_vertical|start" android:text="@string/raha_enable" />
            <LinearLayout android:id="@+id/wakeOptions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:alpha="0.4" android:layout_marginTop="@dimen/space_md">
                <TextView style="@style/Text.Secondary" android:text="@string/raha_wake_hint" />
<com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/wakeHey" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
        android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
        android:textDirection="rtl" android:gravity="center_vertical|start" android:text="@string/raha_wake_hey" /><com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/wakeHello" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
        android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
        android:textDirection="rtl" android:gravity="center_vertical|start" android:text="@string/raha_wake_hello" /><com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/wakeName" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_target" android:paddingStart="@dimen/space_sm" android:paddingEnd="@dimen/space_sm"
        android:buttonTint="@null" android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
        android:textDirection="rtl" android:gravity="center_vertical|start" android:text="@string/raha_wake_name" />
            </LinearLayout>
            <TextView android:id="@+id/wakeVolumeLabel" style="@style/Text.Secondary"
                android:layout_marginTop="@dimen/space_md" android:text="حداقل بلندی صدا برای فعال شدن رها" />
            <SeekBar android:id="@+id/wakeVolume" android:layout_width="match_parent" android:layout_height="@dimen/touch_target"
                android:max="100" android:progressTint="@color/accent" android:thumbTint="@null"
                android:contentDescription="حداقل بلندی صدا برای فعال شدن رها" />
            <TextView style="@style/Text.Caption"
                android:text="با افزایش این مقدار، صداهای آرام‌تر رها را فعال نمی‌کنند. صفر یعنی بدون محدودیت. این تنظیم روی دکمهٔ فرمان و شنیدن دستور پس از فعال شدن اثری ندارد." />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/callsEnabled" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:minHeight="@dimen/touch_target" android:buttonTint="@null" android:paddingStart="@dimen/space_sm"
                    android:textColor="@color/text_primary" android:textSize="@dimen/text_body" android:text="تماس از طریق رها" />
                <Button android:id="@+id/contacts" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="16dp" android:visibility="gone" android:text="مخاطب‌ها" />
            </LinearLayout>
            <TextView android:id="@+id/contactsStatus" style="@style/Text.Caption" android:visibility="gone" />
            <com.abrar.voyahiran.feature.subscription.VipCheckBox android:id="@+id/showTranscript" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_target" android:buttonTint="@null"
                android:textColor="@color/text_primary" android:textSize="@dimen/text_body"
                android:text="@string/raha_show_transcript" />
            <TextView android:id="@+id/error" style="@style/Text.Caption" android:visibility="gone" android:accessibilityLiveRegion="polite" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
