<resources>
 <style name="Theme.VoyahIran.Dialog" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">@font/iransansx</item>
  <item name="android:colorAccent">@color/accent</item><item name="android:colorBackgroundFloating">@color/surface</item>
  <item name="android:textColorPrimary">@color/text_primary</item><item name="android:textColorSecondary">@color/text_secondary</item>
  <item name="android:buttonStyle">@style/Oem.Button</item><item name="android:editTextStyle">@style/Oem.EditText</item>
 </style>
<style name="Theme.VoyahIran" parent="android:style/Theme.Material.NoActionBar">
