    <string name="rear_camera_reboot_title">راه‌اندازی مجدد لازم است</string>
    <string name="rear_camera_reboot_message">برای فعال‌شدن دوربین پایش صندلی‌های عقب، دستگاه باید دوباره راه‌اندازی شود. اکنون راه‌اندازی مجدد شود؟ خودرو متوقف باشد.</string>
