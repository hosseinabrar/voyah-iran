<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoyahIran.Notice" parent="Theme.VoyahIran">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
    <style name="Theme.VoyahIran" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">start</item>
    </style>
    <style name="Text.Secondary" parent="Text.Body">
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Caption" parent="Text.Secondary">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
    <style name="Text.Title" parent="Text.Body">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="Text.Heading" parent="Text.Title">
        <item name="android:textSize">@dimen/text_heading</item>
    </style>
    <style name="NavigationTab" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_navigation</item>
        <item name="android:textColor">@color/navigation_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="ReportCheckBox" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@color/accent</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:enabled">false</item>
    </style>
    <style name="PermissionTile" parent="android:style/Widget.Material.CompoundButton.CheckBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:layout_margin">@dimen/space_xs</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@color/accent</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:enabled">false</item>
    </style>
</resources>

