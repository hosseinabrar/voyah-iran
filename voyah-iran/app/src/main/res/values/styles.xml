<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VoyahLauncher" parent="android:style/Theme.Material.NoActionBar">
        <!-- The OEM safe-area cover bridges to our theme-aware first frame, not a stale task preview. -->
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowAnimationStyle">@style/Animation.VoyahLauncher</item>
    </style>
    <style name="Animation.VoyahLauncher" parent="@android:style/Animation.Activity">
        <item name="android:activityOpenEnterAnimation">@anim/launcher_c_enter</item>
        <item name="android:activityCloseEnterAnimation">@anim/launcher_c_enter</item>
        <item name="android:taskOpenEnterAnimation">@anim/launcher_c_enter</item>
        <item name="android:taskCloseEnterAnimation">@anim/launcher_c_enter</item>
        <item name="android:taskToFrontEnterAnimation">@anim/launcher_c_enter</item>
        <item name="android:taskToBackEnterAnimation">@anim/launcher_c_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/launcher_c_exit</item>
        <item name="android:activityCloseExitAnimation">@anim/launcher_c_exit</item>
        <item name="android:taskOpenExitAnimation">@anim/launcher_c_exit</item>
        <item name="android:taskCloseExitAnimation">@anim/launcher_c_exit</item>
        <item name="android:taskToFrontExitAnimation">@anim/launcher_c_exit</item>
        <item name="android:taskToBackExitAnimation">@anim/launcher_c_exit</item>
    </style>
    <style name="Theme.VoyahIran.Notice" parent="Theme.VoyahIran">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:backgroundDimAmount">0.6</item>
    </style>
    <style name="Theme.VoyahIran" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">@font/iransansx</item>
        <item name="android:windowLightStatusBar">@bool/oem_light_theme</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:checkboxStyle">@style/Oem.CheckBox</item>
        <item name="android:radioButtonStyle">@style/Oem.Segment</item>
        <item name="android:buttonStyle">@style/Oem.Button</item>
        <item name="android:buttonStyleToggle">@style/Oem.Toggle</item>
        <item name="android:seekBarStyle">@style/Oem.SeekBar</item>
        <item name="android:spinnerStyle">@style/Oem.Spinner</item>
        <item name="android:editTextStyle">@style/Oem.EditText</item>
        <item name="android:alertDialogTheme">@style/Theme.VoyahIran.Dialog</item>
        <item name="android:colorControlNormal">@color/text_secondary</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:colorControlHighlight">@color/ripple</item>
        <item name="android:textColorHint">@color/hint_text</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="android:colorBackgroundFloating">@color/surface</item>
    </style>
    <style name="Text.Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">start</item>
    </style>
    <style name="Text.Secondary" parent="Text.Body">
        <item name="android:textSize">@dimen/text_secondary_size</item>
        <item name="android:textColor">@color/text_secondary</item>
    </style>
    <style name="Text.Caption" parent="Text.Secondary">
        <item name="android:textSize">@dimen/text_caption</item>
    </style>
    <style name="Text.Title" parent="Text.Body">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">@font/iransansx_bold</item>
    </style>
    <style name="Text.Heading" parent="Text.Title">
        <item name="android:textSize">@dimen/text_heading</item>
    </style>
    <style name="NavigationTab" parent="android:style/Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/touch_target</item>
        <item name="android:maxLines">1</item>
        <item name="android:autoSizeTextType">uniform</item>
        <item name="android:autoSizeMinTextSize">8sp</item>
        <item name="android:autoSizeMaxTextSize">@dimen/text_body</item>
        <item name="android:autoSizeStepGranularity">1sp</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:background">@drawable/bg_navigation</item>
        <item name="android:textColor">@color/navigation_text</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:gravity">center</item>
    </style>
    <style name="ReportCheckBox" parent="Oem.CheckBox">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@null</item>
        <item name="android:textDirection">rtl</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:clickable">false</item>
        <item name="android:focusable">false</item>
        <item name="android:enabled">false</item>
    </style>
    <style name="PermissionTile" parent="Oem.CheckBox">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">@dimen/touch_target</item>
        <item name="android:layout_margin">@dimen/space_xs</item>
        <item name="android:padding">@dimen/space_sm</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:buttonTint">@null</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:enabled">false</item>
    </style>
</resources>
