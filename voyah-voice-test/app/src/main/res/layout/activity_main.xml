<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:background="#1E223D" android:layoutDirection="rtl">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp" android:gravity="center_horizontal">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/title" android:textSize="28sp" android:textColor="#FFFFFF" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/subtitle" android:textSize="16sp" android:textColor="#C5CADE" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:labelFor="@id/engine" android:text="@string/engine_label"
            android:textSize="15sp" android:textColor="#C5CADE" />
        <Spinner android:id="@+id/engine" android:layout_width="match_parent" android:layout_height="56dp"
            android:layout_marginTop="8dp" android:spinnerMode="dropdown" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/loading" android:textSize="15sp"
            android:textColor="#70D6C7" android:accessibilityLiveRegion="polite" />
        <TextView android:id="@+id/transcript" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="160dp" android:layout_marginTop="16dp" android:background="@drawable/result_background"
            android:gravity="center" android:textDirection="firstStrong" android:textSize="26sp" android:textColor="#FFFFFF"
            android:hint="@string/placeholder" android:textColorHint="#8992AE" android:textIsSelectable="true"
            tools:text="حالت اکو را فعال کن" />
        <ProgressBar android:id="@+id/level" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="12dp"
            android:max="100" android:progressTint="#70D6C7" android:importantForAccessibility="no" />
        <TextView android:id="@+id/metrics" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:textColor="#C5CADE" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="vertical" android:background="@drawable/result_background">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/command_title" android:textColor="#70D6C7" android:textSize="15sp" />
            <TextView android:id="@+id/commandSummary" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/command_waiting" android:textColor="#FFFFFF"
                android:textSize="20sp" android:accessibilityLiveRegion="polite" tools:text="شیشهٔ راننده کاملاً باز می‌شود" />
            <TextView android:id="@+id/commandDetails" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:layoutDirection="ltr" android:textDirection="ltr" android:gravity="left"
                android:textColor="#C5CADE" android:textSize="12sp" android:fontFamily="monospace" android:textIsSelectable="true" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/command_preview" android:textColor="#A6AEC6" android:textSize="12sp" />
        </LinearLayout>
        <Button android:id="@+id/listen" android:layout_width="match_parent" android:layout_height="64dp"
            android:layout_marginTop="28dp" android:text="@string/start" android:textSize="18sp"
            android:backgroundTint="#70D6C7" android:textColor="#152B30" android:enabled="false" />
        <Button android:id="@+id/repeat" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:layout_marginTop="8dp" android:text="@string/repeat_audio"
            android:textSize="14sp" android:enabled="false" />
        <Button android:id="@+id/shareSamples" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="52dp" android:layout_marginTop="8dp" android:text="@string/share_samples" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:gravity="center" android:text="@string/footer"
            android:textSize="12sp" android:textColor="#A6AEC6" />
    </LinearLayout>
</ScrollView>
